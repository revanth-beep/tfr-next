generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── NextAuth models ───────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  registrations Registration[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application models ────────────────────────────────────────────────────────

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  description String
  date        DateTime
  format      String   @default("Online")
  duration    Int      @default(60)
  location    String?
  totalSeats  Int      @default(30)
  topic       String?

  // Comma-separated track names (SQLite-compatible; parsed to array in app)
  tracks String @default("")

  // Practitioner as JSON string
  practitioner String?

  coverNote    String?
  recordingUrl String?

  isPublished Boolean @default(false)
  isFeatured  Boolean @default(false)

  registrations Registration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageContent {
  id String @id @default("main")

  // Hero
  heroLine1   String @default("Practitioner-led.")
  heroLine2   String @default("Community-driven.")
  heroLine3   String @default("Built for serious finance careers.")
  heroTagline String @default("The room you were never told about. Now open.")

  // Beliefs strip
  belief1 String @default("Finance is not learned in classrooms.")
  belief2 String @default("The best network knows more than you.")
  belief3 String @default("Judgment cannot be modelled.")
  belief4 String @default("Access is the actual asset.")

  // Who it is for
  whoHeadline          String @default("For those who have done the work — and are ready for")
  whoHeadlineHighlight String @default("what the work doesn't teach.")
  whoBody              String @default("If you have ever felt the gap between what finance looks like on paper and how it actually moves — you already understand why The Finance Room exists. This is not for those beginning to learn finance. It is for those who know enough to know what they are still missing.")

  // Insider series
  insiderLine1 String @default("One practitioner.")
  insiderLine2 String @default("One real decision.")
  insiderLine3 String @default("No version for the classroom.")
  insiderBody  String @default("Every significant financial decision has a room behind it — where conviction is tested, where deals live or die, and where judgment matters more than any model. The Insider Series is your way in.")
  insiderNote  String @default("Free to attend · Live sessions · By application only")

  insiderPanel1Title String @default("A real decision, not a case study")
  insiderPanel1Body  String @default("Every detail that gets removed to make something teachable is the detail that matters most. Nothing is sanitised here.")
  insiderPanel2Title String @default("The layer above the technical")
  insiderPanel2Body  String @default("What shifts a room. What the model missed. The judgment that separates those who understand finance from those who practise it.")
  insiderPanel3Title String @default("Access that compounds")
  insiderPanel3Body  String @default("One session is a perspective shift. A year of sessions is a different career trajectory.")
}

model Registration {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  yearsInFinance String?
  currentRole    String?
  city           String?
  track          String?

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}
